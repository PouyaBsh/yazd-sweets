{
  "name": "yazd-sweets",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/download-images.mjs && node scripts/build-image-variants.mjs",
    "dev": "next dev",
    "download-images": "node scripts/download-images.mjs",
    "download-images:force": "node scripts/download-images.mjs --force",
    "prebuild": "node scripts/download-images.mjs && node scripts/build-image-variants.mjs",
    "build": "next build",
    "start": "next start",
    "export": "node scripts/export-static.mjs",
    "preview:static": "node scripts/serve-static.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "audit": "node scripts/audit-site.mjs",
    "audit:install": "playwright install chromium",
    "image-variants": "node scripts/build-image-variants.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
